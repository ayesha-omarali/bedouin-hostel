---
import Calendar from './Calendar.astro';
---

<section class="relative min-h-screen flex items-center justify-center">
  <!-- Background image -->
  <img
    src="/src/assets/jamming.webp"
    alt="jamming section"
    class="absolute inset-0 w-full h-full object-cover"
  />

  <!-- Dark overlay for readability -->
  <div class="absolute inset-0 bg-black/40"></div>

  <!-- Content -->
  <div class="relative z-10 max-w-lg w-full px-6 md:px-0">
    <div class="bg-black/50 backdrop-blur-sm p-6 md:p-8 rounded-xl space-y-6 text-white">
      <h2 class="text-4xl md:text-5xl font-bold">Join the Weekly Vibe</h2>

      <p class="text-gray-200 text-sm md:text-base">
        Community nights, music, and moments that make Bedouin feel like home.
      </p>

      <!-- Weekly Schedule -->
      <div class="divide-y divide-white/10">
        <div class="flex justify-between py-3">
          <span class="uppercase tracking-wider text-sm text-gray-300">Monday</span>
          <span class="font-medium">Jam Session 🎸</span>
        </div>

        <div class="flex justify-between py-3">
          <span class="uppercase tracking-wider text-sm text-gray-300">Wednesday</span>
          <span class="font-medium">Movie Night 🎬</span>
        </div>

        <div class="flex justify-between py-3">
          <span class="uppercase tracking-wider text-sm text-gray-300">Friday</span>
          <span class="font-medium">Karaoke Night 🎤</span>
        </div>

        <div class="flex justify-between py-3">
          <span class="uppercase tracking-wider text-sm text-gray-300">Always</span>
          <span class="font-medium text-gray-200">Pop-up dinners, rooftop hangs & surprises</span>
        </div>
      </div>

      <!-- CTA -->
      <p class="text-sm text-gray-300 pt-2">
        Schedules evolve — ask at reception or follow along on Instagram.
      </p>
    </div>
  </div>
</section>
